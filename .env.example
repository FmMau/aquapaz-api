DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:04mfonsecam@gmail.com
# Exact origins only, no paths or wildcard; add localhost explicitly for local testing.
WEB_PUSH_ORIGINS=https://fmmau.github.io
JWT_SECRET=
JWT_EXPIRES_IN=1h
PORT=3000

# Public origin of this backend, without /api. HTTPS is required for OAuth.
AUTH_PUBLIC_URL=https://aquapaz-api-production.up.railway.app

# Transactional SMTP account. Keep these credentials on the backend only.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
AUTH_MAIL_FROM=

# Google OAuth client of type Web application.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple Services ID for the web authorization flow.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# PEM key, with literal \n separators when configured as one environment variable.
APPLE_PRIVATE_KEY=

# Pipas: test tariff. Use real only after setting every rate explicitly.
PIPA_TARIFA_MODO=prueba
PIPA_BASE_CENTAVOS=10000
PIPA_LITRO_CENTAVOS=10
PIPA_KM_CENTAVOS=1500
# Server-only key with Google Routes API enabled. Never expose in EXPO_PUBLIC_*.
# Without this key or on routing failure, the UI labels distance/ETA as approximate.
GOOGLE_ROUTES_API_KEY=
