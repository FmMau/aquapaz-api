DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
JWT_SECRET=
JWT_EXPIRES_IN=1h
PORT=3000

# Public origin of this backend, without /api. HTTPS is required for OAuth.
AUTH_PUBLIC_URL=https://aquapaz-api-production.up.railway.app

# Transactional SMTP account. Keep these credentials on the backend only.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
AUTH_MAIL_FROM=

# Google OAuth client of type Web application.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple Services ID for the web authorization flow.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# PEM key, with literal \n separators when configured as one environment variable.
APPLE_PRIVATE_KEY=
